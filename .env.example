# Sao chép file này thành .env rồi điền giá trị cho máy mình.
# .env KHÔNG được commit.

# --- Đường dẫn ---
CORD19_DIR=data/raw/cord19-2020-05-19
TREC_DIR=data/external

# --- Mô hình ---
# Cache model để không tải lại mỗi lần chạy
HF_HOME=models/hf
HF_HUB_DISABLE_SYMLINKS_WARNING=1
MEDCPT_QUERY_MODEL=ncbi/MedCPT-Query-Encoder
MEDCPT_ARTICLE_MODEL=ncbi/MedCPT-Article-Encoder
MEDCPT_CROSS_MODEL=ncbi/MedCPT-Cross-Encoder

# --- Tính toán ---
TORCH_DEVICE=auto

# --- Web ---
FLASK_APP=trec_covid.web.app
FLASK_PORT=5000
FLASK_DEBUG=1
